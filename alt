<script>
/* ================================================================
   EFFECT 1 — SCRAMBLE-IN: text assembles from random glyphs while
   each character spirals into place. Fires on scroll into view
   for [data-scramble] headings, and once on load for the hero.
   ================================================================ */
const GLYPHS = "!<>-_\\/[]{}=+*^?#XKQZ0123456789";

function splitChars(el){
  const text = el.textContent;
  el.textContent = "";
  const chars = [];
  for (const ch of text){
    const s = document.createElement("span");
    s.className = "ch";
    s.textContent = ch === " " ? "\u00A0" : ch;
    s.dataset.final = s.textContent;
    el.appendChild(s);
    chars.push(s);
  }
  return chars;
}

function scrambleIn(chars, duration = 900){
  chars.forEach((c, i) => {
    const final = c.dataset.final;
    if (final === "\u00A0"){ return; }
    const start = performance.now() + i * 26;
    function tick(now){
      const t = (now - start) / duration;
      if (t < 0){ requestAnimationFrame(tick); return; }
      if (t >= 1){ c.textContent = final; c.style.transform = ""; c.style.opacity = ""; return; }
      if (Math.random() < 0.55){
        c.textContent = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      // spiral: angle advances, radius shrinks
      const ang = t * Math.PI * 4;
      const r = (1 - t) * 16;
      c.style.transform =
        `translate(${Math.cos(ang) * r}px, ${Math.sin(ang) * r}px) rotate(${(1 - t) * 200}deg)`;
      c.style.opacity = (0.15 + 0.85 * t).toFixed(2);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  });
}

/* ================================================================
   EFFECT 2 — SEPARATION + SWIRL: letters repel from the cursor with
   rotation and spring back (lerp). Click = burst that scatters all
   characters before they settle home.
   ================================================================ */
function makeSwirl(el){
  const chars = splitChars(el);
  const st = chars.map(() => ({ x:0, y:0, tx:0, ty:0, rot:0, trot:0 }));

  el.addEventListener("mousemove", e => {
    const r = el.getBoundingClientRect();
    const mx = e.clientX - r.left, my = e.clientY - r.top;
    const R = 130;
    chars.forEach((c, i) => {
      const cr = c.getBoundingClientRect();
      const cx = cr.left - r.left + cr.width / 2;
      const cy = cr.top - r.top + cr.height / 2;
      const dx = cx - mx, dy = cy - my;
      const d = Math.hypot(dx, dy);
      if (d < R && d > 0.01){
        const f = (1 - d / R);
        st[i].tx = (dx / d) * f * 34;
        st[i].ty = (dy / d) * f * 34;
        st[i].trot = (dx / d) * f * 46;
      }
    });
  });
  el.addEventListener("mouseleave", () => st.forEach(s => { s.tx = s.ty = 0; s.trot = 0; }));
  el.addEventListener("click", () => {
    st.forEach(s => {
      const a = Math.random() * Math.PI * 2;
      const d = 50 + Math.random() * 90;
      s.tx = Math.cos(a) * d;
      s.ty = Math.sin(a) * d;
      s.trot = (Math.random() - 0.5) * 220;
    });
    setTimeout(() => st.forEach(s => { s.tx = s.ty = 0; s.trot = 0; }), 320);
  });

  (function loop(){
    chars.forEach((c, i) => {
      const s = st[i];
      s.x += (s.tx - s.x) * 0.11;
      s.y += (s.ty - s.y) * 0.11;
      s.rot += (s.trot - s.rot) * 0.11;
      c.style.transform = `translate(${s.x.toFixed(1)}px, ${s.y.toFixed(1)}px) rotate(${s.rot.toFixed(1)}deg)`;
    });
    requestAnimationFrame(loop);
  })();
}

/* ================================================================
   EFFECT 3 — STRAY DIGITS: the glitch from the case file. A random
   digit is injected into a random word for a moment, then removed.
   ================================================================ */
function strayDigitTicker(container){
  const words = container.querySelectorAll("p");
  setInterval(() => {
    const p = words[Math.floor(Math.random() * words.length)];
    const text = p.textContent;
    if (text.length < 12) return;
    const pos = 4 + Math.floor(Math.random() * (text.length - 8));
    const digit = Math.floor(Math.random() * 10);
    const before = text.slice(0, pos), after = text.slice(pos);
    p.innerHTML = escapeHtml(before) +
      `<span class="stray">${digit}</span>` + escapeHtml(after);
    setTimeout(() => { p.textContent = text; }, 850);
  }, 700);
}
function escapeHtml(s){
  return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

