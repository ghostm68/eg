<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>word☆nexus // ARCHITECTURAL_SYS_V5.17</title>

  <link rel="icon" type="image/png" href="/svg/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/svg/favicon.svg" />
  <link rel="shortcut icon" href="/svg/favicon.ico" />

  <!-- Geist & Geist Mono for the exact contentarchitecture.dev typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <base target="_blank">

  <style>
    :root {
      --bg: #070707;
      --surface: #0d0d0d;
      --surface-hover: #141414;
      --line: #222222;
      --line-bright: #3a3a3a;
      --text-main: #f2f2f2;
      --text-muted: #777777;
      --text-dim: #383838;
      --red: #ff0033;
      --ed-accent: #ff0033;
      --primary: #ff0033;
      --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      background: var(--bg);
      color: var(--text-main);
    }

    ::selection {
      background: var(--red);
      color: #fff;
    }

    .mono {
      font-family: 'Geist Mono', monospace;
    }

    a {
      color: inherit;
    }

    /* =========================================
       ARCHITECTURAL GRID & CROSSHAIRS
       ========================================= */
    .arch-wrapper {
      max-width: 1280px;
      margin: 0 auto;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      position: relative;
      background: var(--bg);
    }

    .arch-row {
      border-bottom: 1px solid var(--line);
      position: relative;
    }

    /* Corner Crosshair Markers (+) */
    .crosshair::before,
    .crosshair::after {
      content: "+";
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
      line-height: 1;
      color: var(--red);
      position: absolute;
      z-index: 10;
      pointer-events: none;
      transform: translate(-50%, -50%);
    }
    .crosshair::before { top: 0; left: 0; }
    .crosshair::after { top: 0; left: 100%; }

    .section-bar {
      padding: 14px 40px;
      background: var(--surface);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .label-tag {
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* =========================================
       MINIMAL TECHNICAL HEADER
       ========================================= */
    header.arch-header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(7, 7, 7, 0.9);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: auto auto 1fr auto auto;
      align-items: stretch;
      height: 52px;
      font-size: 12px;
    }

    .header-cell {
      display: flex;
      align-items: center;
      padding: 0 20px;
      border-right: 1px solid var(--line);
      white-space: nowrap;
    }

    .header-cell:last-child {
      border-right: none;
    }

    .brand {
      font-weight: 600;
      letter-spacing: -0.02em;
      font-size: 14px;
      gap: 10px;
      cursor: pointer;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      background: var(--red);
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 8px var(--red);
    }

    /* Slide-Up Trigger Button ("Learn More" style) */
    .drawer-trigger {
      background: transparent;
      color: var(--text-main);
      border: none;
      padding: 0 24px;
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
      transition: color 0.3s var(--ease-out-expo);
    }

    .drawer-trigger::before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--text-main);
      transform: translateY(101%);
      transition: transform 0.35s var(--ease-out-expo);
      z-index: 0;
    }

    .drawer-trigger.red-fill::before {
      background: var(--red);
    }

    .drawer-trigger:hover::before {
      transform: translateY(0);
    }

    .drawer-trigger:hover {
      color: var(--bg);
    }

    .drawer-trigger.red-fill:hover {
      color: #fff;
    }

    .drawer-trigger span {
      position: relative;
      z-index: 1;
    }

    /* =========================================
       HERO & TRIANGLE CALIBRATION STAGE
       ========================================= */
    .hero-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
    }

    .hero-main {
      padding: 64px 40px;
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 32px;
    }

    .hero-title {
      font-size: clamp(1.85rem, 3.4vw, 3rem);
      font-weight: 500;
      line-height: 1.08;
      letter-spacing: -0.04em;
    }

    .hero-quote {
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
      color: var(--text-muted);
      border-left: 2px solid var(--red);
      padding-left: 16px;
      line-height: 1.6;
    }

    .hero-side {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .side-box {
      padding: 28px 32px;
      border-bottom: 1px solid var(--line);
      font-size: 12px;
      line-height: 1.6;
      color: var(--text-muted);
    }

    .side-box:last-child {
      border-bottom: none;
      flex-grow: 1;
    }

    /* Triangle Video inside Architectural Blueprint Cell */
    .triangle-stage {
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 24px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 36px 24px;
      position: relative;
    }

    .triangle-video-frame {
      width: 100%;
      max-width: 340px;
      aspect-ratio: 1 / 0.866;
      position: relative;
      clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
      background: #111;
      filter: drop-shadow(0 0 20px rgba(255, 0, 51, 0.25));
    }

    .triangle-video-frame video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* =========================================
       SOVEREIGN SYSTEM MODULES (BENTO GRID)
       ========================================= */
    .modules-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: var(--line);
      gap: 1px;
    }

    .module-card {
      background: var(--bg);
      padding: 32px 28px;
      text-decoration: none;
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 190px;
      position: relative;
      overflow: hidden;
      transition: background 0.25s ease;
    }

    .module-card:hover {
      background: var(--surface-hover);
    }

    .module-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      color: var(--text-muted);
    }

    .module-name {
      font-family: 'Geist Mono', monospace;
      font-size: 16px;
      font-weight: 500;
      margin: 24px 0 8px 0;
      letter-spacing: -0.02em;
    }

    .module-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .module-slide-cta {
      margin-top: 20px;
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      height: 16px;
      overflow: hidden;
      position: relative;
      color: var(--text-main);
    }

    .module-slide-cta .inner {
      display: flex;
      flex-direction: column;
      transition: transform 0.35s var(--ease-out-expo);
    }

    .module-card:hover .module-slide-cta .inner {
      transform: translateY(-16px);
    }

    /* =========================================
       SHORT STORY ARCHITECTURE & TEXT EFFECT
       ========================================= */
    .story-layout {
      display: grid;
      grid-template-columns: 320px 1fr;
    }

    .story-sidebar {
      border-right: 1px solid var(--line);
      padding: 40px;
      position: sticky;
      top: 52px;
      height: calc(100vh - 52px);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .story-content {
      padding: 64px 56px;
      max-width: 820px;
    }

    .story-node {
      font-size: clamp(1.06rem, 1.4vw, 1.22rem);
      line-height: 1.75;
      margin-bottom: 36px;
      color: var(--text-main);
      opacity: 0.16;
      filter: blur(0.5px);
      transform: translateY(6px);
      transition: opacity 0.55s var(--ease-out-expo),
                  filter 0.55s var(--ease-out-expo),
                  transform 0.55s var(--ease-out-expo);
      position: relative;
      padding-left: 20px;
      border-left: 2px solid transparent;
    }

    .story-node.active-read {
      opacity: 1;
      filter: blur(0px);
      transform: translateY(0);
      border-left-color: var(--red);
    }

    .story-node.passed-read {
      opacity: 0.45;
      filter: blur(0px);
      transform: translateY(0);
    }

    .story-node::before {
      content: attr(data-line);
      position: absolute;
      left: -38px;
      top: 6px;
      font-family: 'Geist Mono', monospace;
      font-size: 10px;
      color: var(--text-dim);
      letter-spacing: 0.05em;
    }

    .cipher-span {
      font-family: 'Geist Mono', monospace;
      font-size: 0.88em;
      background: rgba(255, 0, 51, 0.09);
      border: 1px solid rgba(255, 0, 51, 0.45);
      padding: 1px 6px;
      color: var(--text-main);
      cursor: crosshair;
      display: inline-block;
    }

    .progress-track {
      width: 100%;
      height: 2px;
      background: var(--line);
      margin-top: 12px;
      position: relative;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: var(--red);
      transition: width 0.1s linear;
    }

    /* =========================================
       2-COLUMN & 3-COLUMN ARCHITECTURAL CELLS
       ========================================= */
    .grid-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: var(--line);
      gap: 1px;
    }

    .grid-3col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: var(--line);
      gap: 1px;
    }

    .arch-cell {
      background: var(--bg);
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
    }

    .arch-btn {
      background: var(--surface);
      color: var(--text-main);
      border: 1px solid var(--line-bright);
      padding: 9px 16px;
      font-family: 'Geist Mono', monospace;
      font-size: 11px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .arch-btn:hover {
      background: var(--red);
      border-color: var(--red);
      color: #fff;
    }

    /* =========================================
       SLIDE-UP CINEMA DRAWER ("LEARN MORE" SHEET)
       ========================================= */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 90;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-out-expo);
    }

    .drawer-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .cinema-drawer {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 100;
      background: var(--bg);
      border-top: 2px solid var(--red);
      transform: translateY(102%);
      transition: transform 0.6s var(--ease-out-expo);
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.95);
    }

    .cinema-drawer.open {
      transform: translateY(0%);
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 40px;
      border-bottom: 1px solid var(--line);
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
    }

    .drawer-body {
      max-width: 1280px;
      width: 100%;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr;
      border-left: 1px solid var(--line);
      border-right: 1px solid var(--line);
      overflow-y: auto;
    }

    .video-stage {
      padding: 32px;
      border-right: 1px solid var(--line);
      background: #030303;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .video-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 1px solid var(--line-bright);
      background: #000;
      position: relative;
      overflow: hidden;
    }

    .video-meta {
      padding: 32px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      font-family: 'Geist Mono', monospace;
      font-size: 12px;
    }

    /* =========================================
       3D PRISM OVERLAY & HERMES TERMINAL
       ========================================= */
    .menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(5, 5, 5, 0.96);
      backdrop-filter: blur(15px);
      z-index: 2000;
      display: none;
      place-items: center;
      overflow-y: auto;
      padding: 40px 20px;
    }
    .menu-overlay.active { display: grid; }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      max-width: 1000px;
      width: 100%;
      text-align: center;
    }
    .prism-wrapper { display: flex; flex-direction: column; align-items: center; }
    .prism-label { font-family: 'Geist Mono', monospace; font-size: 11px; color: #888; margin-bottom: 12px; letter-spacing: 2px; }
    .prism-scene { width: 110px; height: 110px; perspective: 500px; }
    .prism { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; animation: spinPrism 12s infinite linear; }
    .prism:hover { animation-play-state: paused; }
    .face {
      position: absolute; width: 110px; height: 110px;
      border: 1px solid var(--red); background: rgba(15, 0, 5, 0.88);
      color: #fff; font-family: 'Geist Mono', monospace; font-size: 12px;
      display: flex; align-items: center; justify-content: center;
      text-decoration: none;
    }
    .face:hover { background: var(--red); color: #000; }
    .face-1 { transform: rotateY(0deg) translateZ(32px); }
    .face-2 { transform: rotateY(120deg) translateZ(32px); }
    .face-3 { transform: rotateY(240deg) translateZ(32px); }
    @keyframes spinPrism { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }

    .hermes-anchor { position: fixed; bottom: 24px; right: 24px; z-index: 1500; }
    .hermes-btn {
      width: 48px; height: 48px; background: var(--bg);
      border: 1px solid var(--red); color: var(--red);
      font-family: 'Geist Mono', monospace; font-size: 16px; font-weight: 600;
      cursor: pointer; transition: 0.2s;
    }
    .hermes-btn:hover { background: var(--red); color: #fff; }
    .hermes-window {
      position: absolute; bottom: 60px; right: 0;
      width: 340px; height: 420px; background: #080808;
      border: 1px solid var(--line-bright); border-top: 2px solid var(--red);
      display: none; flex-direction: column; padding: 16px;
      font-family: 'Geist Mono', monospace; box-shadow: 0 20px 50px rgba(0,0,0,0.9);
    }
    .hermes-window.active { display: flex; }
    .hermes-output {
      flex: 1; overflow-y: auto; font-size: 11px; color: #ccc;
      margin-bottom: 10px; border: 1px solid var(--line); padding: 10px; background: #030303;
    }
    /* =========================================
       MOBILE & TABLET ARCHITECTURAL RESPONSIVENESS
       (Replace existing @media rules with this block)
       ========================================= */
    @media (max-width: 960px) {
      /* Prevent right-edge crosshair (+) from causing horizontal mobile wobble */
      .arch-wrapper {
        overflow-x: clip;
        border-left: none;
        border-right: none;
      }
      .crosshair::before { left: 10px; }
      .crosshair::after { left: calc(100% - 10px); }

      .hero-grid,
      .story-layout,
      .drawer-body,
      .grid-2col,
      .grid-3col {
        grid-template-columns: 1fr !important;
      }

      .hero-main {
        border-right: none;
        border-bottom: 1px solid var(--line);
        padding: 36px 24px;
        gap: 20px;
      }

      /* Sticky compact telemetry bar while reading the story on mobile */
      .story-sidebar {
        position: sticky;
        top: 48px;
        z-index: 30;
        height: auto;
        background: rgba(10, 10, 10, 0.95);
        backdrop-filter: blur(10px);
        border-right: none;
        border-bottom: 1px solid var(--line-bright);
        padding: 16px 20px;
      }
      .story-sidebar h2 { font-size: 18px !important; margin-top: 4px !important; }
      .story-sidebar > div:last-child { display: none; } /* Hide desktop hover tip on touchscreens */
      .story-sidebar > div:first-child > div:last-child { margin-top: 12px !important; }

      .menu-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }
    }

    @media (max-width: 640px) {
      /* 1. COMPACT 3-CELL MOBILE HEADER (No overflow) */
      header.arch-header {
        grid-template-columns: auto auto 1fr;
        height: 48px;
      }
      .hide-mobile,
      .brand .mono {
        display: none !important;
      }
      .header-cell.brand {
        padding: 0 12px;
        font-size: 13px;
        gap: 6px;
      }
      .drawer-trigger {
        padding: 0 12px;
        font-size: 11px;
        justify-content: center;
      }
      #openCinemaBtn span {
        font-size: 10px;
        letter-spacing: -0.02em;
      }

      /* 2. TIGHTEN HERO & TRIANGLE STAGE */
      .hero-title {
        font-size: 1.55rem;
        line-height: 1.15;
      }
      .triangle-stage {
        padding: 24px 16px;
      }
      .triangle-video-frame {
        max-width: 240px;
      }
      .side-box {
        padding: 20px;
      }

      /* 3. SECTION BARS: CLEAN STACK OR ELLIPSIS */
      .section-bar {
        padding: 10px 16px;
        font-size: 10px;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
      }

      /* 4. BENTO MODULES: TIGHT 2x4 MATRIX INSTEAD OF TALL 1-COL STACK */
      .modules-grid {
        grid-template-columns: repeat(2, 1fr) !important;
      }
      .module-card {
        padding: 18px 14px;
        min-height: 125px;
      }
      .module-name {
        font-size: 13px;
        margin: 12px 0 4px 0;
        word-break: break-all;
      }
      .module-desc {
        font-size: 11px;
        line-height: 1.35;
      }
      .module-slide-cta {
        margin-top: 10px;
        font-size: 10px;
      }

      /* 5. STORY READER ON MOBILE */
      .story-content {
        padding: 28px 16px;
      }
      .story-node {
        font-size: 1.02rem;
        line-height: 1.65;
        margin-bottom: 24px;
        padding-left: 14px;
      }
      /* Put line number inline above paragraph on mobile */
      .story-node::before {
        position: static;
        display: block;
        margin-bottom: 4px;
        color: var(--red);
        font-size: 10px;
      }

      /* 6. SCALE THE 960px FLIPBOOK PROPORTIONALLY TO FIT PHONE SCREENS */
      #archives {
        padding: 24px 16px !important;
      }
      #flipbook-wrapper {
        min-height: 290px !important;
        height: 290px !important;
        padding: 0 !important;
        position: relative;
      }
      #flipbook {
        transform: scale(0.35);
        transform-origin: center center;
        flex-shrink: 0;
      }

      /* 7. ASTRAL MATRIX: 3x4 GRID INSTEAD OF CRUSHED 6x2 */
      #archives + section + div + section {
        padding: 24px 16px !important;
      }
      #zodiac-grid {
        grid-template-columns: repeat(3, 1fr) !important;
        gap: 6px !important;
      }

      /* 8. GENERAL CELLS, DRAWER & HERMES WINDOW */
      .arch-cell {
        padding: 24px 16px;
      }
      .drawer-header {
        padding: 12px 16px;
        font-size: 10px;
      }
      .video-stage,
      .video-meta {
        padding: 20px 16px;
      }
      .hermes-anchor {
        bottom: 16px;
        right: 16px;
      }
      .hermes-window {
        width: calc(100vw - 32px);
        height: 360px;
      }
      footer.arch-row {
        padding: 24px 16px !important;
        text-align: left !important;
      }
      footer.arch-row > div {
        text-align: left !important;
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="arch-wrapper">
    
    <!-- 00 // STICKY ARCHITECTURAL HEADER -->
    <header class="arch-header">
      <div class="header-cell brand" onclick="window.scrollTo({top:0, behavior:'smooth'})">
