/* scramble [data-scramble] headings when they enter the viewport */
const seen = new WeakSet();
const io = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if (en.isIntersecting && !seen.has(en.target)){
      seen.add(en.target);
      scrambleIn(splitChars(en.target), 800);
      io.unobserve(en.target);
    }
  });
}, { threshold: 0.4 });
document.querySelectorAll("[data-scramble]").forEach(el => io.observe(el));
