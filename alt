    const closeBtn = document.getElementById('closeCinemaBtn');

    function toggleDrawer(isOpen) {
      cinemaDrawer.classList.toggle('open', isOpen);
      drawerBackdrop.classList.toggle('open', isOpen);
      cinemaDrawer.setAttribute('aria-hidden', !isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    openBtns.forEach(btn => btn?.addEventListener('click', () => toggleDrawer(true)));
    closeBtn.addEventListener('click', () => toggleDrawer(false));
    drawerBackdrop.addEventListener('click', () => toggleDrawer(false));

    /* 2. MENU & HERMES TOGGLES */
    function toggleMenu() {
      document.getElementById('menuOverlay').classList.toggle('active');
    }
    function toggleHermes() {
      document.getElementById('hermes-window').classList.toggle('active');
    }

    /* 3. GLYPH SCRAMBLE & SCROLL SPOTLIGHT FOR "THE GREAT AI HUSTLE" */
    const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789𓅈◬↯☼◈▲/';

    function scrambleText(element) {
      if (element.dataset.scrambling === 'true') return;
      element.dataset.scrambling = 'true';

      const original = element.dataset.value || element.innerText;
      let iteration = 0;

      const interval = setInterval(() => {
        element.innerText = original
          .split('')
          .map((char, index) => {
            if (char === ' ') return ' ';
            if (index < iteration) return original[index];
            return glyphs[Math.floor(Math.random() * glyphs.length)];
          })
          .join('');

        if (iteration >= original.length) {
          clearInterval(interval);
          element.innerText = original;
          element.dataset.scrambling = 'false';
        }
        iteration += 0.5;
      }, 25);
    }

    document.querySelectorAll('.cipher-span').forEach(span => {
      span.addEventListener('mouseenter', () => scrambleText(span));
    });

    const storyNodes = document.querySelectorAll('.story-node');
    const indicator = document.getElementById('activeBlockIndicator');
    const progressBar = document.getElementById('storyProgress');

    function updateStoryFocus() {
      const viewportCenter = window.innerHeight * 0.48;
      let closestNode = null;
      let minDistance = Infinity;
      let activeIndex = 0;

      storyNodes.forEach((node, idx) => {
        const rect = node.getBoundingClientRect();
        const nodeCenter = rect.top + rect.height / 2;
        const distance = Math.abs(viewportCenter - nodeCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestNode = node;
          activeIndex = idx;
        }
      });

      storyNodes.forEach((node, idx) => {
        const wasActive = node.classList.contains('active-read');
        node.classList.remove('active-read', 'passed-read');

        if (node === closestNode) {
          node.classList.add('active-read');
          if (!wasActive) {
            node.querySelectorAll('.cipher-span').forEach(span => scrambleText(span));
          }
        } else if (idx < activeIndex) {
          node.classList.add('passed-read');
        }
      });

      const formattedIndex = String(activeIndex + 1).padStart(2, '0');
      const total = String(storyNodes.length).padStart(2, '0');
      indicator.textContent = `${formattedIndex} / ${total}`;
      progressBar.style.width = `${((activeIndex + 1) / storyNodes.length) * 100}%`;
    }

    window.addEventListener('scroll', updateStoryFocus, { passive: true });
    window.addEventListener('resize', updateStoryFocus);
    updateStoryFocus();
  </script>

