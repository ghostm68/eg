/* ================================================================
   EFFECT 4 — VORTEX: the phrase repeated along spiral arms on a
   canvas. Letters orbit their polar slot with angular spring
   physics, drift with the whole vortex, glitch into random glyphs,
   repel from the cursor, and CLICK re-deals every letter into a
   fresh arrangement before the springs pull it back into spiral.
   ================================================================ */
(function(){
  const canvas = document.getElementById("vortex");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  const PHRASE = "THE CONTENT ARCHITECTURE";
  const VG = "!<>-_/[]{}=+*^?#XKQZ0123456789";
  let W,H,DPR,cx,cy,maxR,chars=[];
  const mouse = {x:-9999,y:-9999};

  function resize(){
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.clientWidth; H = canvas.clientHeight;
    canvas.width = W*DPR; canvas.height = H*DPR;
    ctx.setTransform(DPR,0,0,DPR,0,0);
    cx = W*0.56; cy = H*0.38;
    maxR = Math.hypot(W,H)*0.44;
    build();
  }

  function deal(){
    // re-deal: every letter gets a NEW random slot on the spiral
    for (const c of chars){
      const arm = Math.floor(Math.random()*5);
      const t = Math.random();
      c.r  = 24 + t*maxR;
      c.a  = arm*(Math.PI*2/5) + t*3.8 + (Math.random()-0.5)*0.2;
    }
  }

  function build(){
    chars = [];
    const ARMS = 5, PER = 150;
    let k = 0;
    for (let arm=0; arm<ARMS; arm++){
      for (let i=0;i<PER;i++){
        const t = i/PER;
        const r = 24 + t*maxR + (Math.random()-0.5)*16;
        const a = arm*(Math.PI*2/5) + t*3.8 + (Math.random()-0.5)*0.14;
        chars.push({
          ch: PHRASE[k++ % PHRASE.length],
          r, a,
          cr: maxR*(0.4 + Math.random()*0.9),   // start scattered…
          ca: Math.random()*Math.PI*2,           // …they fly in on load
          va: 0, dx: 0, dy: 0, g: 0
        });
      }
    }
    deal();
  }

  canvas.addEventListener("mousemove", e => {
    const r = canvas.getBoundingClientRect();
    mouse.x = e.clientX - r.left;
    mouse.y = e.clientY - r.top;
  });
  canvas.addEventListener("mouseleave", () => { mouse.x = mouse.y = -9999; });
  canvas.addEventListener("click", () => {
    deal();                                        // new arrangement
    for (const c of chars) c.va += (Math.random()-0.5)*0.5;  // spin burst
  });

  let last = performance.now();
  function frame(now){
    const dt = Math.min((now - last)/16.6, 3); last = now;
    ctx.clearRect(0,0,W,H);
    ctx.textAlign = "center"; ctx.textBaseline = "middle";
    const MR = 150;
    for (const c of chars){
      c.a += 0.00055*dt;                           // whole vortex slowly rotates
      c.va += ((c.a - c.ca)*0.0018 - c.va*0.008)*dt;   // angular spring to slot
      c.ca += c.va*dt;
      c.cr += (c.r - c.cr)*0.02*dt;                // radial spring to slot
      const bx = cx + Math.cos(c.ca)*c.cr;
      const by = cy + Math.sin(c.ca)*c.cr;
      // cursor repulsion
      const mx = bx + c.dx - mouse.x, my = by + c.dy - mouse.y;
      const d = Math.hypot(mx, my);
      if (d < MR && d > 0.01){
        const f = (1 - d/MR)*2.6*dt;
        c.dx += (mx/d)*f; c.dy += (my/d)*f;
      }
      c.dx *= Math.pow(0.88, dt); c.dy *= Math.pow(0.88, dt);
      const x = bx + c.dx, y = by + c.dy;
      if (c.ch === " ") continue;
      // depth cue: smaller + dimmer toward the eye of the vortex
      const depth = Math.min(1, Math.max(0, (c.cr - 20)/(maxR*0.9)));
      const size = 9 + depth*7;
      ctx.font = size.toFixed(1)+"px ui-monospace, Menlo, Consolas, monospace";
      let ch = c.ch;
      if (c.g > 0){ ch = VG[Math.floor(Math.random()*VG.length)]; c.g--; }
      else if (Math.random() < 0.002){ c.g = 2; }  // occasional glyph glitch
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(c.ca + Math.PI/2 + c.va*6);         // tangent + swirl spin
      ctx.fillStyle = "rgba(237,234,226," + (0.35 + depth*0.6).toFixed(2) + ")";
      ctx.fillText(ch, 0, 0);
      ctx.restore();
    }
    requestAnimationFrame(frame);
  }

  window.addEventListener("resize", resize);
  resize();
  requestAnimationFrame(frame);
})();

