<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QUEER // UHER 5000 • ELECTRIC PENCIL</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<style>
  /* ── 00. LOAD CUSTOM FONTS ── */
  @font-face {
    font-family: 'WSB';
    src: url('https://raw.githubusercontent.com/ghostm68/eg/main/fonts/wsb-regular.woff2') format('woff2');
    font-display: swap;
  }
  @font-face {
    font-family: 'Olivetti-M15';
    src: url('https://raw.githubusercontent.com/ghostm68/inktwo/main/fonts/Web437_Olivetti_M15.woff') format('woff');
    font-display: swap;
  }

  :root {
    --bg-deck: #060708;
    --chassis: #121417;
    --bezel: #202329;
    --primary: #ff1a2a; /* Electric pencil & active red */
    --red-glow: rgba(255, 26, 42, 0.45);
    --tape-charcoal: #0b0d0f;
    --phosphor-white: #e6edf3;
    --font-odometer: 'VT323', monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg-deck);
    color: var(--phosphor-white);
    font-family: 'Olivetti-M15', monospace;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px 16px;
  }

  /* ── ELECTRIC PENCIL HERO MASTHEAD ── */
  .ink-hero-pencil-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: -20px;
    z-index: 10;
    pointer-events: none;
  }

  .hero-pencil {
    width: 100px;
    height: 100px;
    animation: pencilFloat 4s ease-in-out infinite;
  }

  .electric-pencil-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── UHER CONSOLE CHASSIS ── */
  .uher-console {
    width: 100%;
    max-width: 840px;
    background: linear-gradient(180deg, #17191e 0%, #0f1013 100%);
    border: 2px solid var(--bezel);
    border-radius: 8px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.95), inset 0 1px 0 rgba(255,255,255,0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── HEADER & SYRINGE GAUGE ── */
  .console-header {
    background: #090a0c;
    padding: 14px 22px;
    border-bottom: 2px solid var(--bezel);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: #666;
    letter-spacing: 1.5px;
  }

  .header-meta span.active {
    color: var(--primary);
    text-shadow: 0 0 8px var(--red-glow);
  }

  .syringe-gauge {
    width: 100%;
    height: 28px;
    display: flex;
    align-items: center;
  }

  /* ── WRITING DESK (TAPE BAY) ── */
  .tape-bay {
    position: relative;
    background: radial-gradient(circle at 50% 30%, #13151a 0%, var(--tape-charcoal) 100%);
    padding: 24px 28px;
    border-bottom: 2px solid var(--bezel);
  }

  .tape-ribbon {
    width: 100%;
    height: 320px;
    background: transparent;
    border: none;
    outline: none;
    color: var(--phosphor-white);
    font-family: 'Olivetti-M15', monospace;
    font-size: 16px;
    line-height: 1.8;
    resize: vertical;
    caret-color: var(--primary);
    letter-spacing: 0.5px;
    transition: text-shadow 0.2s ease, color 0.2s ease;
  }

  .tape-ribbon::placeholder { color: #2e333d; }

  /* Bias Saturation Modes */
  .tape-ribbon.bias-mid {
    text-shadow: 0 0 6px rgba(255,255,255,0.4);
  }
  .tape-ribbon.bias-hot {
    color: #ffb3b8;
    text-shadow: 0 0 8px var(--primary), 0 0 16px var(--red-glow);
  }

  /* ── DASHBOARD: UHER ODOMETER & WHEELS ── */
  .deck-dashboard {
    background: #0a0b0d;
    padding: 12px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #000;
  }

  .odometer-housing {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #000;
    padding: 4px 8px;
    border: 2px solid var(--bezel);
    border-radius: 4px;
  }

  .odometer-label {
    font-size: 10px;
    color: #555;
    letter-spacing: 1px;
  }

  .odometer-digits { display: flex; gap: 3px; }

  .digit-drum {
    background: #111;
    color: #f0f0f0;
    font-family: var(--font-odometer);
    font-size: 24px;
    line-height: 1;
    width: 18px;
    text-align: center;
    border: 1px solid #222;
    border-radius: 2px;
    box-shadow: inset 0 3px 6px rgba(0,0,0,0.9), inset 0 -3px 6px rgba(0,0,0,0.9);
  }

  .reset-btn {
    background: #252830;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid #444;
    cursor: pointer;
  }
  .reset-btn:active { background: var(--primary); }

  /* ── THUMBWHEELS ── */
  .thumbwheels { display: flex; gap: 24px; }

  .wheel-unit {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: #777;
    cursor: pointer;
    user-select: none;
  }

  .wheel-unit .status-tag {
    color: var(--primary);
    min-width: 45px;
  }

  .thumbwheel {
    width: 14px;
    height: 28px;
    background: repeating-linear-gradient(180deg, #111 0px, #111 2px, #333 3px, #111 4px);
    border: 1px solid #444;
    border-radius: 2px;
    box-shadow: inset 0 0 4px #000;
  }

  /* ── PIANO TRANSPORT KEYS ── */
  .transport-deck {
    background: #121418;
    padding: 16px 22px;
    display: flex;
    gap: 8px;
  }

  .piano-key {
    flex: 1;
    height: 48px;
    background: linear-gradient(180deg, #24272f 0%, #15171c 100%);
    border: 1px solid #323640;
    border-radius: 4px;
    color: #999;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    box-shadow: 0 4px 0 #08090a, 0 6px 12px rgba(0,0,0,0.6);
    transition: all 0.08s ease;
    user-select: none;
  }

  .piano-key:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #08090a, 0 2px 4px rgba(0,0,0,0.6);
  }

  .piano-key.rec-key { color: #fff; }
  .rec-lamp {
    width: 7px;
    height: 7px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--primary);
    animation: blink-rec 1.2s step-start infinite;
  }
  @keyframes blink-rec { 50% { opacity: 0.2; } }

  .cut-key { color: #ff9999; border-color: #4a2228; }
</style>
</head>
<body>

<!-- ── ELECTRIC PENCIL HERO COMPONENT ── -->
<div class="ink-hero-pencil-wrap">
  <div class="hero-pencil">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" class="electric-pencil-svg" aria-hidden="true">
      <defs>
        <filter id="electric-glow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>
      <style>
        .ep-body { fill: #0a0a0a; stroke: var(--primary, #ff0000); stroke-width: 3.5; }
        .ep-stroke { stroke: var(--primary, #ff0000); stroke-width: 3.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
        .ep-fill { fill: var(--primary, #ff0000); stroke: none; }
        .ep-bolt { stroke: #ffffff; stroke-width: 2.5; fill: none; filter: url(#electric-glow); animation: zap 1.2s infinite alternate; }
        .ep-bolt .spark { fill: #ffffff; stroke: none; filter: url(#electric-glow); animation: zap 1.2s infinite alternate; }
        @keyframes zap {
          0% { opacity: 0.6; stroke: var(--primary, #ff0000); }
          50% { opacity: 1; stroke: #ffffff; }
          100% { opacity: 0.9; stroke: #ff4444; }
        }
        @keyframes pencilFloat {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-12px); }
        }
      </style>
      <g transform="rotate(-45 250 250)">
        <path d="M 230 70 L 270 70 A 15 15 0 0 1 270 100 L 230 100 A 15 15 0 0 1 230 70 Z" class="ep-body" />
        <rect x="230" y="100" width="40" height="20" class="ep-stroke" />
        <line x1="230" y1="108" x2="270" y2="108" class="ep-stroke" />
        <line x1="230" y1="114" x2="270" y2="114" class="ep-stroke" />
        <polygon points="230,120 270,120 270,350 230,350" class="ep-body" />
        <line x1="243" y1="120" x2="243" y2="350" class="ep-stroke" />
        <line x1="257" y1="120" x2="257" y2="350" class="ep-stroke" />
        <polygon points="230,350 270,350 250,410" class="ep-body" />
        <line x1="243" y1="350" x2="250" y2="410" class="ep-stroke" />
        <line x1="257" y1="350" x2="250" y2="410" class="ep-stroke" />
        <polygon points="245,395 255,395 250,410" class="ep-fill" />
        <g class="ep-bolt">
          <path d="M 250 410 L 244 430 L 254 445 L 246 475 L 252 490" />
          <path d="M 250 410 L 230 425 L 238 440 L 215 465" />
          <path d="M 250 410 L 268 428 L 260 445 L 285 470" />
          <path d="M 245 425 L 220 435" />
          <path d="M 255 435 L 275 440" />
          <circle cx="210" cy="475" r="3" class="spark" />
          <circle cx="290" cy="478" r="2.5" class="spark" />
          <circle cx="250" cy="498" r="3.5" class="spark" />
          <circle cx="230" cy="445" r="2" class="spark" />
          <circle cx="270" cy="450" r="2" class="spark" />
        </g>
      </g>
    </svg>
  </div>
</div>

<!-- ── UHER 5000 CONSOLE ── -->
<div class="uher-console">
  <!-- 01. SYRINGE HEADER -->
  <div class="console-header">
    <div class="header-meta">
      <span>UNIVERSALGERÄT // QUEER.SYS</span>
      <span class="active">REC • TAPE ARMED</span>
    </div>
    <div class="syringe-gauge">
      <svg viewBox="0 0 800 28" width="100%" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <line x1="2" y1="14" x2="60" y2="14" stroke="#888" stroke-width="1.5"/>
        <polygon points="58,11 68,14 58,17" fill="#888"/>
        <rect x="68" y="4" width="640" height="20" rx="3" stroke="#444" stroke-width="1.5" fill="#090a0c"/>
        <rect id="syringe-fluid" x="70" y="6" width="30" height="16" rx="2" fill="url(#redGrip)"/>
        <path d="M120 4v6 M180 4v10 M240 4v6 M300 4v10 M360 4v6 M420 4v10 M480 4v6 M540 4v10 M600 4v6 M660 4v10" stroke="#333" stroke-width="1.5"/>
        <rect x="708" y="11" width="60" height="6" fill="#333"/>
        <circle cx="780" cy="14" r="10" stroke="#444" stroke-width="2"/>
        <defs>
          <linearGradient id="redGrip" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#7a050f"/>
            <stop offset="100%" stop-color="#ff1a2a"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <!-- 02. MAGNETIC TAPE BAY -->
  <div class="tape-bay">
    <textarea id="tape-buffer" class="tape-ribbon" spellcheck="false" placeholder="TRANSMISSION BUFFER • RECORDING DIRECT TO TAPE..."></textarea>
  </div>

  <!-- 03. UHER ODOMETER & WHEELS -->
  <div class="deck-dashboard">
    <div class="odometer-housing">
      <span class="odometer-label">UHER 5000 // WORDS</span>
      <div class="odometer-digits">
        <div class="digit-drum" id="d3">0</div>
        <div class="digit-drum" id="d2">0</div>
        <div class="digit-drum" id="d1">0</div>
        <div class="digit-drum" id="d0">0</div>
      </div>
      <div class="reset-btn" id="reset-counter" title="Zero Counter"></div>
    </div>

    <!-- Thumbwheel Controls: Interactive! -->
    <div class="thumbwheels">
      <div class="wheel-unit" id="bias-toggle" title="Click to Cycle Magnetic Saturation">
        <span>BIAS</span>
        <div class="thumbwheel"></div>
        <span class="status-tag" id="bias-label">RAW</span>
      </div>
      <div class="wheel-unit" id="varispeed-toggle" title="Click to Pitch-Shift Font Engine">
        <span>VARISPEED</span>
        <div class="thumbwheel"></div>
        <span class="status-tag" id="speed-label">M15</span>
      </div>
    </div>
  </div>

  <!-- 04. PIANO KEYS -->
  <div class="transport-deck">
    <button class="piano-key rec-key"><div class="rec-lamp"></div>REC</button>
    <button class="piano-key" id="btn-clean">CLEAN</button>
    <button class="piano-key cut-key" id="btn-cut" title="Burroughs Scissor Cut-Up">CUT ✂</button>
    <button class="piano-key" id="btn-eject">EJECT [TXT]</button>
  </div>
</div>

<script>
  const buffer = document.getElementById('tape-buffer');
  const d3 = document.getElementById('d3');
  const d2 = document.getElementById('d2');
  const d1 = document.getElementById('d1');
  const d0 = document.getElementById('d0');
  const fluid = document.getElementById('syringe-fluid');

  // 1. Live Word Count & Syringe Fill
  buffer.addEventListener('input', () => {
    const text = buffer.value.trim();
    const words = text ? text.split(/\s+/).length : 0;
    
    const padded = String(Math.min(words, 9999)).padStart(4, '0');
    d3.textContent = padded[0];
    d2.textContent = padded[1];
    d1.textContent = padded[2];
    d0.textContent = padded[3];

    const fluidWidth = Math.min(30 + (words * 3), 636);
    fluid.setAttribute('width', fluidWidth);
  });

  // 2. Reset Counter
  document.getElementById('reset-counter').addEventListener('click', () => {
    buffer.value = '';
    buffer.dispatchEvent(new Event('input'));
  });

  // 3. BIAS WHEEL: Cycles Magnetic Saturation (RAW -> MID-GLOW -> HOT-TUBE)
  const biasModes = ['RAW', 'SAT', 'HOT'];
  let currentBias = 0;
  document.getElementById('bias-toggle').addEventListener('click', () => {
    currentBias = (currentBias + 1) % biasModes.length;
    const mode = biasModes[currentBias];
    document.getElementById('bias-label').textContent = mode;
    buffer.classList.remove('bias-mid', 'bias-hot');
    if (mode === 'SAT') buffer.classList.add('bias-mid');
    if (mode === 'HOT') buffer.classList.add('bias-hot');
  });

  // 4. VARISPEED WHEEL: Pitch-Shifts Font Engine (Olivetti M15 <-> WSB Burroughs)
  let isWSB = false;
  document.getElementById('varispeed-toggle').addEventListener('click', () => {
    isWSB = !isWSB;
    if (isWSB) {
      buffer.style.fontFamily = "'WSB', monospace";
      buffer.style.fontSize = "19px";
      document.getElementById('speed-label').textContent = 'WSB';
    } else {
      buffer.style.fontFamily = "'Olivetti-M15', monospace";
      buffer.style.fontSize = "16px";
      document.getElementById('speed-label').textContent = 'M15';
    }
  });

  // 5. Burroughs Cut-Up Scissor Trigger
  document.getElementById('btn-cut').addEventListener('click', () => {
    const text = buffer.value.trim();
    if (!text) return;
    const pieces = text.split(/([.,!?;:\n]+|\s{2,})/);
    for (let i = pieces.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pieces[i], pieces[j]] = [pieces[j], pieces[i]];
    }
    buffer.value = pieces.join(' ').replace(/\s+/g, ' ').trim();
    buffer.dispatchEvent(new Event('input'));
  });

  // 6. Clean Text (Removes extra line breaks/formatting)
  document.getElementById('btn-clean').addEventListener('click', () => {
    buffer.value = buffer.value.replace(/\n\s*\n/g, '\n').trim();
  });

  // 7. Eject TXT File
  document.getElementById('btn-eject').addEventListener('click', () => {
    const blob = new Blob([buffer.value], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'queer_dispatch_' + Date.now() + '.txt';
    a.click();
  });
</script>
</body>
</html>
